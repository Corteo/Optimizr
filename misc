if (!function_exists('varName')) {
    function varName($v)
    {
        $trace = debug_backtrace();
        $vLine = file(__FILE__);
        $fLine = $vLine[$trace[0]['line'] - 1];
        preg_match("#\\$(\w+)#", $fLine, $match);
        print_r($match['1']);
    }
}
